# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production


# typescript
*.tsbuildinfo

# local database (PGlite schema checks)
/.pglite

# build output
/dist

# review screenshots
/review

# local development database (npm run db:start)
/.postgres

# playwright
/test-results
/playwright-report

# local logs and screenshots
/.logs

# uploaded product images (a Docker volume in production)
/uploads
