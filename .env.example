# Copy to .env.local for development, or to .env next to docker-compose.yml on the server.
# Every variable is optional in development; production needs the ones marked REQUIRED.

# ─── App ──────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# REQUIRED in production. Public origin of the storefront (no trailing slash):
# canonical URLs, sitemap, Open Graph tags, email links and auth origin checks.
SITE_URL=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────
# Local: the project database from `npm run db:start` (localhost only, disposable).
# Production never reads this value — docker-compose.yml builds its own URL from POSTGRES_PASSWORD.
DATABASE_URL=postgres://quattro:quattro@localhost:5433/quattro

# REQUIRED for docker-compose.yml. URL-safe: `openssl rand -hex 24`
POSTGRES_PASSWORD=CHANGE_ME

# ─── Auth ─────────────────────────────────────────────────────────────
# REQUIRED in production (32+ characters): `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# ─── Email (Resend) ───────────────────────────────────────────────────
# Without a key, emails (order receipts, password resets) are written to the log instead.
RESEND_API_KEY=
EMAIL_FROM="QUATTRO <orders@example.com>"
# Staff inbox for new-order and contact-form notifications.
ORDER_NOTIFY_EMAIL=

# ─── Media ────────────────────────────────────────────────────────────
# Uploaded photos are stored on disk (a Docker volume) and served at /media.
# Set only if a CDN or another origin serves them, e.g. https://media.example.com
MEDIA_URL=

# ─── Analytics (optional, cookieless Umami) ───────────────────────────
# Both must be set to load the script, e.g. https://analytics.example.com/script.js
ANALYTICS_SCRIPT_URL=
ANALYTICS_WEBSITE_ID=

# ─── Network ──────────────────────────────────────────────────────────
# "true" only if every request comes through Cloudflare's proxy (orange cloud):
# rate limits then key on CF-Connecting-IP. Otherwise leave empty — that header
# could be forged by anyone.
BEHIND_CLOUDFLARE=

# ─── Deployment (docker-compose.yml) ──────────────────────────────────
# Domain Caddy serves and obtains TLS certificates for.
SITE_DOMAIN=example.com
QUATTRO_APP_IMAGE=ghcr.io/OWNER/quattro:latest
QUATTRO_MIGRATOR_IMAGE=ghcr.io/OWNER/quattro-migrator:latest
