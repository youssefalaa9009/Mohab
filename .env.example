# ─── App ──────────────────────────────────────────────────────────────
# Public origin of the storefront (no trailing slash). Used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────
# Local: your own Postgres instance. Docker Compose: postgres://quattro:<password>@db:5432/quattro
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/quattro

# Used only by docker-compose.yml to initialise the database container.
POSTGRES_PASSWORD=CHANGE_ME

# ─── Media (Cloudflare R2, S3-compatible) — Phase 7 ───────────────────
# Public base URL of the bucket (custom domain recommended), e.g. https://media.example.com
NEXT_PUBLIC_MEDIA_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ─── Auth (Better Auth) — Phase 5 ─────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ─── Email (Resend) — Phase 6 ─────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="QUATTRO <orders@example.com>"

# ─── Bot protection (Cloudflare Turnstile) — Phase 6 ──────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Internal cron endpoint shared secret — Phase 6 ───────────────────
CRON_SECRET=

# ─── Deployment ───────────────────────────────────────────────────────
# Domain Caddy serves (and obtains TLS certificates for).
SITE_DOMAIN=example.com
