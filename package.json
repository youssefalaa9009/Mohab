{
  "name": "quattro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env.local server/index.ts",
    "build": "run-s build:client build:ssr build:node",
    "build:client": "vite build --outDir dist/client",
    "start": "node --env-file-if-exists=.env.local --env-file=.env.production dist/node/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "tsx scripts/check-migrations.ts",
    "media:examples": "tsx scripts/example-media.ts",
    "check": "run-s lint format:check typecheck db:check build",
    "build:ssr": "vite build --ssr src/entry.server.tsx --outDir dist/server",
    "build:node": "vite build --ssr server/index.ts --outDir dist/node",
    "db:start": "tsx scripts/db-local.ts",
    "dev:all": "run-p db:start dev",
    "test:e2e": "playwright test",
    "admin:create": "tsx --env-file-if-exists=.env.local scripts/create-admin.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/middie": "^9.3.4",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "embla-carousel-react": "^8.6.0",
    "fastify": "^5.12.5",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^7.18.4",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "npm-run-all": "^4.1.5",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.19"
  },
  "type": "module"
}
